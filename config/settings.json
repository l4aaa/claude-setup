{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "auto",
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(!**/.env.example)",
      "Read(!**/.env.sample)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa)",
      "Read(**/id_ecdsa)",
      "Read(**/id_ed25519)",
      "Read(**/credentials)",
      "Read(**/credentials.json)",
      "Read(**/.credentials.json)",
      "Read(**/.netrc)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.claude.json)",
      "Bash(gh pr merge *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * main)",
      "Bash(git push * master)",
      "PowerShell(gh pr merge *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(git push * main)",
      "PowerShell(git push * master)"
    ]
  },
  "extraKnownMarketplaces": {
    "l4aaa-toolkit": {
      "source": { "source": "github", "repo": "l4aaa/claude-setup" },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "guardrails@l4aaa-toolkit": true
  }
}
